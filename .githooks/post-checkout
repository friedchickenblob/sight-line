#!/bin/sh
# Warns right away when you switch to a branch whose name doesn't follow <owner>/<what-it-does>.
# It can't stop the checkout; the pre-push hook and the "Branch name" action enforce it.
# Enable once per clone with: make hook  (or: git config core.hooksPath .githooks)

[ "$3" = "1" ] || exit 0                            # only branch switches, not file checkouts
branch=$(git symbolic-ref --short -q HEAD) || exit 0   # detached HEAD: nothing to check
sh "$(dirname "$0")/check-branch-name" "$branch" 2>&1 >/dev/null | sed 's/ERROR:/WARNING:/' >&2
exit 0
